<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img 
      class="profile-img" 
      src="systems/pokevtt/icons/{{system.moveType}}.png" 
      title="{{item.name}}"
      data-edit="img"
    />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="attributes">Attributes</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedDescription target="system.description" engine="prosemirror" button=true editable=editable}}
    </div>

    <div class="tab attributes" data-group="primary" data-tab="attributes">
      {{!-- Tipo de movimiento --}}
      <div class="resource">
        <label for="system.moveType" class="resource-label">Tipo de Movimiento</label>
        <select name="system.moveType">
          {{#select system.moveType}}
          {{#each config.types as |name type|}}
          <option value="{{type}}">{{name}}</option>
          {{/each}}
          {{/select}}
        </select>
      </div>

      {{!-- Opciones de tirada --}}
      <div class="resource">
        <label class="resource-label">Opciones de tirada</label>
        <div class="form-group">
          <label class="checkbox">
            <input type="checkbox" name="system.hasAttackRoll" {{checked system.hasAttackRoll}}/> Incluir tirada de ataque
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox">
            <input type="checkbox" name="system.hasDamageRoll" {{checked system.hasDamageRoll}}/> Incluir tirada de daño
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox">
            <input type="checkbox" name="system.hasDifficulty" {{checked system.hasDifficulty}}/> Incluir dificultad
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox">
            <input type="checkbox" name="system.showDistance" {{checked system.showDistance}}/> Incluir distancia
          </label>
        </div>
      </div>

      {{!-- Selección de Atributo para dificultad si está habilitada --}}
      {{#if system.hasDifficulty}}
      <div class="resource">
        <label for="system.difficultyAttribute" class="resource-label">Atributo del Atacante</label>
        <select name="system.difficultyAttribute">
          {{#each actorAttributes as |ability key|}}
          <option value="{{key}}" {{#if (eq ../system.difficultyAttribute key)}}selected{{/if}}>
            {{localize (lookup ../config.abilities key)}}
          </option>
          {{/each}}
        </select>
        
        <label for="system.defenseAttribute" class="resource-label">Atributo de Defensa</label>
        <select name="system.defenseAttribute">
          {{#each actorAttributes as |ability key|}}
          <option value="{{key}}" {{#if (eq ../system.defenseAttribute key)}}selected{{/if}}>
            {{localize (lookup ../config.abilities key)}}
          </option>
          {{/each}}
        </select>
        
        <label for="system.difficultyBase" class="resource-label">Dificultad Base</label>
        <select name="system.difficultyBase">
          <option value="3" {{#if (eq system.difficultyBase "3")}}selected{{/if}}>Fácil (+3)</option>
          <option value="5" {{#if (eq system.difficultyBase "5")}}selected{{/if}}>Normal (+5)</option>
          <option value="8" {{#if (eq system.difficultyBase "8")}}selected{{/if}}>Difícil (+8)</option>
        </select>
      </div>
      {{/if}}

      {{!-- Resto de los atributos solo si hay tirada de daño --}}
      {{#if system.hasDamageRoll}}
      <div class="resource">
        <label class="resource-label">Daño</label>
        <div class="grid grid-4col">
          <div class="grid-span-1">
            <label class="resource-label">Cantidad de dados</label>
            <input
              type="text"
              name="system.roll.diceNum"
              value="{{system.roll.diceNum}}"
              data-dtype="Number"
            />
          </div>
          <div class="grid-span-1">
            <label class="resource-label">Daño</label>
            <input
              type="text"
              name="system.roll.diceSize"
              value="{{system.roll.diceSize}}"
              data-dtype="String"
            />
          </div>
          <div class="grid-span-2">
            <label class="resource-label">Modificador</label>
            <span
              type="text"
              name="system.roll.diceBonus"
              value="1"
              data-dtype="String"
            />
          </div>
        </div>
      </div>
      {{/if}}

      {{!-- Selección de Atributo solo si hay tirada de ataque --}}
      {{#if system.hasAttackRoll}}
      <div class="resource">
        <label for="system.attributeModifier" class="resource-label">Atributo Modificador</label>
        <select name="system.attributeModifier">
          {{#each actorAttributes as |ability key|}}
      <option value="{{key}}" {{#if (eq ../system.attributeModifier key)}}selected{{/if}}>
        {{localize (lookup ../config.abilities key)}}
      </option>          {{/each}}
        </select>
        </div>
      {{/if}}

      {{#if system.showDistance}}
      <div class="resource">
        <label for="system.attributeModifier" class="resource-label">Distancia</label>
          <input
            type="number"
            name="system.distance"
            value="{{system.distance}}"
            placeholder="0"
            min="0"
          />
      </div>
      {{/if}}

    </div>
  </section>

</form>

<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>Quantity</label>
          <input
            type='text'
            name='system.quantity'
            value='{{system.quantity}}'
            data-dtype='Number'
          />
        </div>
        <div class='resource'>
          <label class='resource-label'>Weight</label>
          <input
            type='text'
            name='system.weight'
            value='{{system.weight}}'
            data-dtype='Number'
          />
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      {{! As you add new fields, add them in here! }}
      <div class='resource'>
        <label class='resource-label'>Tirada:</label>
        <div class='grid grid-3col'>
          <div>
            <label class='resource-label'>Número de Dados</label>
            <input 
              type='number' 
              name='system.roll.diceNum' 
              value='{{system.roll.diceNum}}' 
              min="0"
              placeholder="0"/>
          </div>
          <div>
            <label class='resource-label'>Tipo de Dado</label>
            <select name='system.roll.diceSize'>
              <option value="d4" {{#if (eq system.roll.diceSize "d4")}}selected{{/if}}>d4</option>
              <option value="d6" {{#if (eq system.roll.diceSize "d6")}}selected{{/if}}>d6</option>
              <option value="d8" {{#if (eq system.roll.diceSize "d8")}}selected{{/if}}>d8</option>
              <option value="d10" {{#if (eq system.roll.diceSize "d10")}}selected{{/if}}>d10</option>
              <option value="d12" {{#if (eq system.roll.diceSize "d12")}}selected{{/if}}>d12</option>
              <option value="d20" {{#if (eq system.roll.diceSize "d20")}}selected{{/if}}>d20</option>
            </select>
          </div>
          <div>
            <label class='resource-label'>Modificador</label>
            <input type='text' name='system.roll.diceBonus' value='{{system.roll.diceBonus}}' placeholder="+0"/>
          </div>
        </div>
      </div>
    </div>
  </section>
</form>
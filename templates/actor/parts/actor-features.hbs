<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>Name</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='Create Feature'
        data-type='feature'
      >
        <i class='fas fa-plus'></i> Add
      </a>
    </div>
  </li>
  {{#each features as |item|}}
    <li class='item flexrow' data-item-id='{{item._id}}' draggable='true'>
      <div class='item-name' style="flex: 1;">
        <div class='item-image'>
          <a class='use-item-button' data-roll-type='item'>
            <img
              src='/systems/pokevtt/icons/{{item.system.moveType}}.png'
              title='{{item.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <h4 class="feature-name">{{item.name}}</h4>
      </div>
      <div class='item-description' style="flex: 2; margin-left: 10px;">
        {{#if item.system.description}}
          {{item.system.description}}
        {{/if}}
      </div>
      <div class='item-roll' style="flex: 1;">
        {{#if item.system.roll}}
          <p class="item-damage">Daño: D{{item.system.roll.diceSize}}</p>
        {{/if}}
        {{#if item.system.showDistance}}
          <p class="item-distance">Distancia: {{item.system.distance}} pies</p>
        {{/if}}
      </div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='Edit Feature'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='Delete Feature'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources grid grid-3col">

        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">Vida</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.power.value" class="resource-label">Estamina</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.power.value" value="{{system.power.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.power.max" value="{{system.power.max}}" data-dtype="Number"/>
          </div>
        </div>

      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="features">Base</a>
   <a class="item" data-tab="pokemon">Pokémon</a>
       <a class="item" data-tab="items">Objetos</a>
    <a class="item" data-tab="historia">Historia</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <section class="grid grid-3col">
        <aside class="sidebar">

          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns.  --}}
          <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d10+@abilities.{{key}}.value" data-label="{{localize (lookup @root.config.abilities key)}}">{{localize (lookup @root.config.abilities key)}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
            </div>
            {{/each}}
          </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
          {{> "systems/pokevtt/templates/actor/parts/actor-features.hbs"}}
        </section>

      </section>
    </div>

    {{!-- Historia Tab --}}
    <div class="tab historia" data-group="primary" data-tab="historia">
      {{editor enrichedBiography target="system.historia" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/pokevtt/templates/actor/parts/actor-items.hbs"}}
    </div>
    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/pokevtt/templates/actor/parts/actor-effects.hbs"}}
    </div>

    {{!-- Nueva sección para Pokémon --}}
    <div class="tab pokemon" data-group="primary" data-tab="pokemon">
      <div class="pokemon-container">
        <section class="equipo">
          <h2>Equipo</h2>
          <div class="pokemon-list" data-count="{{system.equipo.length}}">
            {{#each system.equipo as |pokemonId|}}
              {{#with (getActor pokemonId) as |pokemon|}}
                <div class="pokemon-entry" data-pokemon-id="{{pokemon._id}}">
                  <img src="{{pokemon.img}}" width="50" height="50"/>
                  <span class="pokemon-name">{{pokemon.name}}</span>
                  <div class="pokemon-controls">
                    <a class="pokemon-control move-to-pc"><i class="fas fa-box"></i></a>
                    <a class="pokemon-control remove-pokemon"><i class="fas fa-times"></i></a>
                  </div>
                </div>
              {{/with}}
            {{/each}}
          </div>
          <button type="button" class="add-pokemon" data-destination="equipo">
            <i class="fas fa-plus"></i> Agregar Pokémon al Equipo
          </button>
        </section>

        <section class="pc">
          <h2>PC</h2>
          <div class="pokemon-list">
            {{#each system.pc as |pokemonId|}}
              {{#with (getActor pokemonId) as |pokemon|}}
                <div class="pokemon-entry" data-pokemon-id="{{pokemon._id}}">
                  <img src="{{pokemon.img}}" width="50" height="50"/>
                  <span class="pokemon-name">{{pokemon.name}}</span>
                  <div class="pokemon-controls">
                    <a class="pokemon-control move-to-team"><i class="fas fa-users"></i></a>
                    <a class="pokemon-control remove-pokemon"><i class="fas fa-times"></i></a>
                  </div>
                </div>
              {{/with}}
            {{/each}}
          </div>
          <button type="button" class="add-pokemon" data-destination="pc">
            <i class="fas fa-plus"></i> Agregar Pokémon al PC
          </button>
        </section>
      </div>
    </div>

    <button id="editButton" class="small-button" disabled></button>

  </section>

</form>
